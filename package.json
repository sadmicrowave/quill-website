{
  "name": "quill-website",
  "version": "0.1.0",
  "private": true,
  "description": "The front-facing landing page and download pages for Quill, deployed on Vercel.",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o public/assets/site.css --minify",
