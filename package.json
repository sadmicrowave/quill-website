    "screens": "../quill-dictation-app/.venv/bin/python tools/make_pdfs.py && python3 tools/pdf_to_svg.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
